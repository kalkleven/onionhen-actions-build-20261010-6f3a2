+// SPDX-License-Identifier: GPL-3.0-or-later
+// Route selection adapted from the pinned compatibility reference documented in
+// PORT_REFERENCE.md. The 13.42 route remains subject to console validation.
+#pragma once
+
+#include <cstdint>
+
+namespace etahen_port {
+inline constexpr const char *toolbox_uri_for_system_version(std::uint32_t version,
+                                                              bool include_settings_mode = true) noexcept {
+    if ((version & 0xffff0000u) >= 0x11000000u) {
+        return "pssettings:play?mode=settings&function=debug_settings_old";
+    }
+    return include_settings_mode
+               ? "pssettings:play?mode=settings&function=debug_settings"
+               : "pssettings:play?function=debug_settings";
+}
+} // namespace etahen_port
+
+#define ETAHEN_TOOLBOX_URI \
+    etahen_port::toolbox_uri_for_system_version(kernel_get_fw_version())
+#define ETAHEN_TOOLBOX_URI_NO_MODE \
+    etahen_port::toolbox_uri_for_system_version(kernel_get_fw_version(), false)
