--- /dev/null
+++ b/libhijacker/source/firmware_profile_1342.hpp
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Profile values adapted from the pinned compatibility reference documented in
+// PORT_REFERENCE.md. This profile is source-derived and still needs hardware
+// validation on firmware 13.42.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace etahen_port {
+
+struct FirmwareProfile {
+    uint32_t version;
+    size_t allproc;
+    size_t security_flags;
+    size_t qa_flags;
+    size_t utoken_flags;
+    size_t root_vnode;
+};
+
+inline constexpr FirmwareProfile kFirmware1342{
+    0x13420000u,
+    0x28c9e80u,
+    0x0d99064u,
+    0x0d99088u,
+    0x0d990f0u,
+    0x3137510u,
+};
+
+inline constexpr const FirmwareProfile *find_firmware_profile(uint32_t version) {
+    return (version & 0xffff0000u) == kFirmware1342.version
+               ? &kFirmware1342
+               : nullptr;
+}
+
+} // namespace etahen_port
