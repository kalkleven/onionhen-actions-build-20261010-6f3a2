+// SPDX-License-Identifier: GPL-3.0-or-later
+// Mono value layout adapted from the pinned compatibility reference documented in
+// PORT_REFERENCE.md; validate against the target runtime before hardware use.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+struct PortNullableInt64 {
+    std::uint8_t has_value;
+    std::uint8_t padding[7];
+    std::int64_t value;
+};
+
+static_assert(sizeof(PortNullableInt64) == 16);
+static_assert(alignof(PortNullableInt64) == 8);
+static_assert(offsetof(PortNullableInt64, value) == 8);
