@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Managed Boot signature classification adapted from the pinned compatibility
+// reference documented in PORT_REFERENCE.md.
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+
+enum class PortBootAbi : std::uint8_t {
+    Unsupported,
+    TwoArguments,
+    StringArgument,
+    NullableInt64
+};
+
+inline bool port_boot_integer32_enum(bool is_enum, const char *underlying,
+                                     int size, unsigned alignment, bool byref) noexcept {
+    return !byref && is_enum && underlying &&
+           (std::strcmp(underlying, "System.Int32") == 0 ||
+            std::strcmp(underlying, "System.UInt32") == 0) &&
+           size == 4 && alignment == 4;
+}
+
+inline PortBootAbi port_boot_abi(unsigned count, bool instance, const char *result,
+                                 const char *first, const char *second, const char *third,
+                                 int size = 0, unsigned alignment = 0,
+                                 bool verified_integer32_enum = false) noexcept {
+    if (instance || !result || std::strcmp(result, "System.Boolean") != 0 ||
+        !first || std::strcmp(first, "System.String") != 0 ||
+        !second ||
+        (!verified_integer32_enum &&
+         std::strcmp(second, "System.Int32") != 0 &&
+         std::strcmp(second, "System.UInt32") != 0)) {
+        return PortBootAbi::Unsupported;
+    }
+
+    if (count == 2) {
+        return PortBootAbi::TwoArguments;
+    }
+    if (count != 3 || !third) {
+        return PortBootAbi::Unsupported;
+    }
+    if (std::strcmp(third, "System.String") == 0) {
+        return PortBootAbi::StringArgument;
+    }
+    if ((std::strcmp(third, "System.Nullable<System.Int64>") == 0 ||
+         std::strcmp(third, "System.Nullable`1<System.Int64>") == 0) &&
+        size == 16 && alignment == 8) {
+        return PortBootAbi::NullableInt64;
+    }
+    return PortBootAbi::Unsupported;
+}
